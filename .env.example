# Copy to .env and fill the three blank passwords before running Compose.
# .env is ignored. Never commit credentials. Use distinct random local values.
COMPOSE_PROJECT_NAME=yolo-vision-studio
BIND_ADDRESS=127.0.0.1

FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_WORKER_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DB_NAME=yolovision
DB_USERNAME=yolovision
DB_PASSWORD=
RABBITMQ_USERNAME=yolovision
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=yolovision
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=videos

APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# AI engine defaults. Model loading happens only through explicit CLI/library calls.
AI_DEVICE=auto
AI_DEFAULT_CONFIDENCE=0.25
AI_DEFAULT_IMAGE_SIZE=960
AI_MAX_VIDEO_DURATION_SECONDS=300
AI_MAX_VIDEO_SIZE_MB=200
# Disk budget for the worker's temporary normalized input and annotated intermediate video.
AI_MAX_INTERMEDIATE_SIZE_MB=4096
AI_MAX_DOWNLOAD_HEIGHT=720
AI_CPU_THREADS=4
AI_MAX_FRAME_PIXELS=8294400
AI_FALLBACK_FPS=30
AI_PROCESSING_TIMEOUT_SECONDS=1800
AI_YOUTUBE_JS_RUNTIME=deno
# Optional direct-process paths; Compose sets absolute container paths.
# AI_MODEL_CACHE_DIR=model-cache
# AI_TEMP_DIR=temp
# AI_OUTPUT_DIR=outputs
# AI_LOCAL_INPUT_DIR=.
# AI_FFMPEG_PATH=ffmpeg
# AI_FFPROBE_PATH=ffprobe
# AI_YOUTUBE_JS_RUNTIME_PATH=/path/to/deno

# Asynchronous detection messaging (Phase 05). Backend and worker read the same values;
# change them together or the two services will declare conflicting queues.
RABBITMQ_COMMAND_EXCHANGE=vision.detection.commands
RABBITMQ_COMMAND_QUEUE=vision.detection.jobs
RABBITMQ_COMMAND_ROUTING_KEY=detection.execute
RABBITMQ_EVENT_EXCHANGE=vision.detection.events
RABBITMQ_EVENT_QUEUE=vision.detection.events.backend
RABBITMQ_EVENT_ROUTING_KEY=detection.status
RABBITMQ_DEAD_LETTER_EXCHANGE=vision.detection.dead-letter.exchange
RABBITMQ_DEAD_LETTER_QUEUE=vision.detection.dead-letter
RABBITMQ_DEAD_LETTER_ROUTING_KEY=detection.dead-letter
# Broker-enforced redelivery bound for quorum queues; keep it above JOB_MAX_RETRIES.
RABBITMQ_DELIVERY_LIMIT=5
# Worker: one inference per process by default; attempts include the first delivery.
WORKER_CONCURRENCY=1
WORKER_PREFETCH_COUNT=1
JOB_MAX_RETRIES=3
WORKER_ALLOW_MODEL_DOWNLOAD=false
WORKER_HEARTBEAT_SECONDS=30
WORKER_SHUTDOWN_TIMEOUT_SECONDS=60
# Backend lease monitor: fail jobs without worker events for this long.
JOB_PROCESSING_TIMEOUT_SECONDS=1800
JOB_QUEUE_TIMEOUT_SECONDS=86400

# Detection REST API (Phase 06). Development-only until authentication exists.
# Server-Sent Events: one shared poller; streams close at terminal job states.
DETECTION_SSE_TIMEOUT_SECONDS=1800
DETECTION_SSE_POLL_INTERVAL_MS=1000
DETECTION_SSE_HEARTBEAT_SECONDS=15
DETECTION_SSE_MAX_CONNECTIONS=100
# OpenAPI document (/api/v1/openapi) and Swagger UI (/api/v1/docs); disable outside development.
API_DOCS_ENABLED=true

# Live Detection (webcam). The gateway allows one session at 5 FPS by default; the internal
# ai-live-worker (no host port) reads prepared models only and uses bounded CPU and memory.
LIVE_MAX_SESSIONS=1
LIVE_MAX_FPS=5
LIVE_MAX_FRAME_BYTES=524288
LIVE_INFERENCE_TIMEOUT=5s
LIVE_IDLE_TIMEOUT=30s
LIVE_MODEL_SIZES=n
LIVE_MAX_LOADED_MODELS=1
LIVE_CPU_THREADS=2
LIVE_WORKER_CPUS=2
LIVE_WORKER_MEMORY_LIMIT=2g
