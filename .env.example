# Copy to .env and fill the three blank passwords before running Compose.
# .env is ignored. Never commit credentials. Use distinct random local values.
COMPOSE_PROJECT_NAME=yolo-vision-studio
BIND_ADDRESS=127.0.0.1

FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_WORKER_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DB_NAME=yolovision
DB_USERNAME=yolovision
DB_PASSWORD=
RABBITMQ_USERNAME=yolovision
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=yolovision
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=videos

APP_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
